{
  "name": "rc-boat-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sunny Cove — 桃花心木经典游艇与水天倒影",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "vite build",
    "serve": "vite preview --host 127.0.0.1 --port 5177",
    "check:viewing": "node tools/checks/viewing-camera-check.mjs && node tools/checks/viewing-audio-check.mjs",
    "check:cove": "node tools/checks/cove-navigation-check.mjs",
    "check:contact": "node --test tools/checks/boat-water-motion-check.mjs tools/checks/boat-water-interaction-check.mjs",
    "check:routes": "node tools/checks/cove-routes-check.mjs",
    "check:assets": "node tools/checks/assets-check.mjs",
    "check:bundle": "node tools/checks/bundle-check.mjs",
    "check:delivery": "node tools/checks/model-delivery-check.mjs",
    "check:tools": "node --test tools/checks/publish-atomic-check.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "meshoptimizer": "0.25.0",
    "tailwindcss": "4.3.3",
    "vite": "^6.4.3"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
